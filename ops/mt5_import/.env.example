# MT5 Import — env template (value-free; safe to commit).
# Copy to `ops/mt5_import/.env` (git-ignored) and fill in locally. NEVER commit the real .env.
#
# NOTE: probe.py (Phase 0C-1) needs NONE of these — it attaches to the running terminal and
# touches no Supabase. These variables are for the LATER writer slices (0C-2 dry-run / 0C-3 writer).

# --- Supabase (writer slices only; service_role is LOCAL/ADMIN ONLY — never ship to browser/Netlify) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Identity / account (writer slices only) ---
# MT5_USER_ID must equal the THUS Journal auth uid so browser RLS SELECT-own works.
MT5_USER_ID=
MT5_SOURCE_ACCOUNT=

# --- MT5 connection (optional; only if NOT attaching to an already-running, logged-in terminal) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# --- Writer guard (0C-3): the writer stays dry-run unless this is explicitly set to 1 ---
MT5_WRITE=
